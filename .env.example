# ============================================================
# DESIGNTECH ENGINEERING — ENVIRONMENT VARIABLES TEMPLATE
# ============================================================
#
# Copy this file to `.env` and fill in real values.
# NEVER commit the real `.env` file to git (it is .gitignored).
#

# ------------------------------------------------------------
# CONTACT FORM — RECEIVER EMAIL
# ------------------------------------------------------------
# Every enquiry submitted from the website contact form will
# be delivered to this inbox.
#
# This is the RECEIVER address. The visitor's email is used
# only as Reply-To so the team can click "Reply" in their
# inbox to respond directly to the enquirer.
#
# Example:
#   designtecheng.team@gmail.com
#
CONTACT_EMAIL=

# ------------------------------------------------------------
# EMAIL DELIVERY — RESEND API KEY
# ------------------------------------------------------------
# Resend (resend.com) is used server-side to send contact
# form enquiries from a verified sender.
#
# The key is ONLY used on the server (/api/contact and the
# Vite local middleware). It is NEVER exposed to the browser.
#
# Create a key at:  https://resend.com/api-keys
#
# During development, without this key set, the form UI
# still flows (loading → success) but mail is not delivered.
# A note is shown in the success state to remind the team.
#
RESEND_API_KEY=
