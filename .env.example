# ============================================================
# DESIGNTECH ENGINEERING — ENVIRONMENT VARIABLES TEMPLATE
# ============================================================
#
# Copy this file to `.env` and fill in real values.
# NEVER commit the real `.env` file to git (it is .gitignored).
#

# ------------------------------------------------------------
# EMAIL DELIVERY — FORMSPREE
# ------------------------------------------------------------
# Formspree is used for client-side secure contact form
# submissions directly to the company inbox.
#
# The endpoint URL is NOT a private secret key — it's a
# form-specific submission URL designed for public browser
# POST requests, while still being safe because it can only
# submit messages TO your form (never read anything).
#
# Setup:
#   1. Create a free or paid form at https://formspree.io
#   2. Configure the form to send email TO:
#        designtecheng.team@gmail.com
#   3. Copy the form endpoint below:
#
#       https://formspree.io/f/xxxxxxxx
#
# NOTE: The contact form automatically sends:
#   _subject  = "New Website Enquiry — {subject}"
#   _replyto  = {visitor's email}
#   _format   = "plain"
#
VITE_FORMSPREE_ENDPOINT=

# ------------------------------------------------------------
# COMPANY EMAIL (for reference / future server-side flows)
# ------------------------------------------------------------
# This is the destination inbox for all enquiries.
#
# IMPORTANT: When using Formspree, the destination email is
# configured DIRECTLY inside the Formspree dashboard on
# their server. Setting this variable here does NOT route
# mail; it is included only for clarity/documentation.
#
CONTACT_EMAIL=designtecheng.team@gmail.com
